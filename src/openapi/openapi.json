{
  "openapi": "3.0.3",
  "info": {
    "title": "maklaGo API",
    "version": "1.0.0",
    "description": "Restaurant POS backend. **Tenant routes** require header `x-tenant-id` (tenant slug or UUID). Most routes need `Authorization: Bearer <JWT>` from `POST /api/v1/auth/login`. **Platform** routes use `x-platform-key`. Errors: `{ \"error\": { \"code\", \"message\", \"details?\" } }`."
  },
  "servers": [{ "url": "/", "description": "Same origin as this server (set to http://localhost:3000 in dev)" }],
  "tags": [
    { "name": "Health" },
    { "name": "Platform" },
    { "name": "Auth" },
    { "name": "Catalog" },
    { "name": "Orders" },
    { "name": "Tables" },
    { "name": "Sessions" },
    { "name": "Stats" },
    { "name": "Settings" },
    { "name": "Staff" }
  ],
  "components": {
    "securitySchemes": {
      "TenantHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-tenant-id",
        "description": "Tenant slug (e.g. `demo`) or tenant UUID from registry."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Staff JWT from `/api/v1/auth/login`."
      },
      "PlatformKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-platform-key",
        "description": "Must match `PLATFORM_API_KEY` on the server."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": {}
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 1 }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "expiresIn": { "type": "string", "example": "7d" },
          "staff": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "email": { "type": "string" },
              "fullName": { "type": "string" },
              "role": { "type": "string", "enum": ["OWNER", "MANAGER", "CASHIER"] }
            }
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "staff": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "email": { "type": "string" },
              "fullName": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["lines"],
        "properties": {
          "tableId": { "type": "string", "format": "uuid", "nullable": true },
          "sessionId": { "type": "string", "format": "uuid", "nullable": true },
          "status": { "type": "string", "enum": ["DRAFT", "ACTIVE"], "default": "ACTIVE" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["productId", "quantity"],
              "properties": {
                "productId": { "type": "string", "format": "uuid" },
                "quantity": { "type": "integer", "minimum": 1, "maximum": 999 },
                "modifierIds": { "type": "array", "items": { "type": "string" } },
                "note": { "type": "string", "maxLength": 500 }
              }
            }
          }
        }
      },
      "OrderStatus": {
        "type": "string",
        "enum": ["DRAFT", "ACTIVE", "COMPLETED", "CANCELED"]
      },
      "PatchOrderStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/OrderStatus" }
        }
      },
      "TableBody": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "zone": { "type": "string", "maxLength": 100, "nullable": true },
          "sortOrder": { "type": "integer" }
        }
      },
      "OpenSessionRequest": {
        "type": "object",
        "properties": {
          "openingFloatCents": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "CloseSessionRequest": {
        "type": "object",
        "properties": {
          "closingNote": { "type": "string", "maxLength": 2000 }
        }
      },
      "PatchTaxRequest": {
        "type": "object",
        "required": ["defaultTaxBps"],
        "properties": {
          "defaultTaxBps": { "type": "integer", "minimum": 0, "maximum": 100000 }
        }
      },
      "ProvisionTenantRequest": {
        "type": "object",
        "required": ["slug", "name", "databaseUrl"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "databaseUrl": { "type": "string", "minLength": 1 },
          "ownerEmail": { "type": "string", "format": "email" },
          "ownerPassword": { "type": "string", "minLength": 8 },
          "ownerFullName": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "description": "If any owner field is set, all three owner fields are required."
      },
      "PatchTenantRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "isActive": { "type": "boolean" },
          "databaseUrl": { "type": "string", "minLength": 1 }
        }
      },
      "StaffCreateBody": {
        "type": "object",
        "required": ["email", "password", "fullName", "role"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 },
          "fullName": { "type": "string" },
          "role": { "type": "string", "enum": ["OWNER", "MANAGER", "CASHIER"] }
        }
      },
      "StaffPatchBody": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 },
          "fullName": { "type": "string" },
          "role": { "type": "string", "enum": ["OWNER", "MANAGER", "CASHIER"] },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "parameters": {
      "OrderId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "TableId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "SessionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "CategoryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ProductId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "TenantKey": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "description": "Tenant UUID or slug" }
      },
      "StaffId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" } } }
              }
            }
          }
        }
      }
    },
    "/platform/v1/tenants": {
      "get": {
        "tags": ["Platform"],
        "summary": "List tenants",
        "security": [{ "PlatformKey": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "post": {
        "tags": ["Platform"],
        "summary": "Provision tenant",
        "security": [{ "PlatformKey": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProvisionTenantRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "format": "uuid" },
                        "slug": { "type": "string" },
                        "name": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
          "401": { "description": "Invalid platform key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
          "409": { "description": "Slug taken", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/platform/v1/tenants/{id}": {
      "get": {
        "tags": ["Platform"],
        "summary": "Get tenant by id or slug",
        "security": [{ "PlatformKey": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantKey" }],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "patch": {
        "tags": ["Platform"],
        "summary": "Update tenant",
        "security": [{ "PlatformKey": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantKey" }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PatchTenantRequest" } } }
        },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "delete": {
        "tags": ["Platform"],
        "summary": "Remove tenant from registry",
        "description": "Deletes the registry row (owners cascade). Does not drop the tenant PostgreSQL database.",
        "security": [{ "PlatformKey": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantKey" }],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Staff login",
        "security": [{ "TenantHeader": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "JWT issued",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "400": { "description": "Validation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Current staff + tenant",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } }, "description": "OK" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/staff": {
      "get": {
        "tags": ["Staff"],
        "summary": "List staff",
        "description": "OWNER or MANAGER only.",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "post": {
        "tags": ["Staff"],
        "summary": "Create staff",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StaffCreateBody" } } }
        },
        "responses": {
          "201": { "description": "Created" },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
          "409": { "description": "Email taken", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/staff/{id}": {
      "get": {
        "tags": ["Staff"],
        "summary": "Get staff member",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StaffId" }],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "patch": {
        "tags": ["Staff"],
        "summary": "Update staff",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StaffId" }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StaffPatchBody" } } }
        },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/catalog/categories": {
      "get": {
        "tags": ["Catalog"],
        "summary": "List categories",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "sortOrder": { "type": "integer" },
                          "position": { "type": "integer" },
                          "productCount": { "type": "integer" },
                          "image": { "type": "string", "nullable": true },
                          "isActive": { "type": "boolean" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "post": {
        "tags": ["Catalog"],
        "summary": "Create category",
        "description": "OWNER or MANAGER only.",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "sortOrder": { "type": "integer" },
                  "position": { "type": "integer" },
                  "image": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/catalog/categories/{id}": {
      "patch": {
        "tags": ["Catalog"],
        "summary": "Update category",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CategoryId" }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "sortOrder": { "type": "integer" },
                  "position": { "type": "integer" },
                  "image": { "type": "string", "nullable": true },
                  "isActive": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "delete": {
        "tags": ["Catalog"],
        "summary": "Soft-delete category and its products",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CategoryId" }],
        "responses": {
          "204": { "description": "No content" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/catalog/upload": {
      "post": {
        "tags": ["Catalog"],
        "summary": "Upload catalog image",
        "description": "OWNER or MANAGER only. Multipart form field `file` (JPEG, PNG, WebP, GIF).",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" } } }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": { "type": "string" },
                    "path": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/catalog/products": {
      "get": {
        "tags": ["Catalog"],
        "summary": "List products",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "post": {
        "tags": ["Catalog"],
        "summary": "Create product",
        "description": "OWNER or MANAGER only.",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["categoryId", "name", "priceCents"],
                "properties": {
                  "categoryId": { "type": "string", "format": "uuid" },
                  "name": { "type": "string" },
                  "description": { "type": "string", "nullable": true },
                  "priceCents": { "type": "integer", "minimum": 0 },
                  "taxRateBps": { "type": "integer", "nullable": true },
                  "modifiers": {},
                  "sortOrder": { "type": "integer" },
                  "position": { "type": "integer" },
                  "image": { "type": "string", "nullable": true },
                  "outOfStock": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Category not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/catalog/products/{id}": {
      "patch": {
        "tags": ["Catalog"],
        "summary": "Update product",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "delete": {
        "tags": ["Catalog"],
        "summary": "Soft-delete product",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
        "responses": {
          "204": { "description": "No content" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/orders": {
      "post": {
        "tags": ["Orders"],
        "summary": "Create order",
        "description": "Optional header `Idempotency-Key`: replays same body and returns existing order with `idempotentReplay: true`.",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderRequest" } } }
        },
        "responses": {
          "200": { "description": "Idempotent replay" },
          "201": { "description": "Created" },
          "400": { "description": "Validation / product not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      },
      "get": {
        "tags": ["Orders"],
        "summary": "List orders",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/OrderStatus" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 50, "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
