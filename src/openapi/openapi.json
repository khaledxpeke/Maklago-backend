        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PatchTaxRequest" } } }
        },
        "responses": {
          "200": { "description": "OK" },
