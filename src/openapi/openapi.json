      }
    },
    "/api/v1/sessions/active": {
      "get": {
        "tags": ["Sessions"],
        "summary": "Current staff open session",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK (session may be null)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "session": { "nullable": true } }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/open": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Open cashier session",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OpenSessionRequest" } } }
        },
        "responses": {
          "201": { "description": "Created" },
          "409": { "description": "Session already open", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/sessions/{id}/close": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Close cashier session",
        "security": [{ "TenantHeader": [], "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/SessionId" }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CloseSessionRequest" } } }
        },
        "responses": {
          "200": { "description": "OK" },
