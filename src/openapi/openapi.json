        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Validation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/tables/{id}": {
      "patch": {
        "tags": ["Tables"],
