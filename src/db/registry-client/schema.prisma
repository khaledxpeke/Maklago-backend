generator client {
  provider = "prisma-client-js"
  output   = "../../src/db/registry-client"
}

datasource db {
  provider = "postgresql"
  url      = env("REGISTRY_DATABASE_URL")
}

/// Platform registry: one row per restaurant tenant; databaseUrl points at the tenant Postgres database.
model Tenant {
  id          String                @id @default(uuid())
  slug        String                @unique
  name        String
  databaseUrl String                @map("database_url")
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at")
  owners      Owner[]
  staffLogins StaffLoginDirectory[]

  @@map("tenants")
}

/// Maps staff email (platform-wide unique) → tenant + staff row for slugless mobile login. Password stays in tenant DB.
model StaffLoginDirectory {
  id              String   @id @default(uuid())
  emailNormalized String   @unique @map("email_normalized")
  tenantId        String   @map("tenant_id")
  staffId         String   @map("staff_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([tenantId, staffId])
  @@map("staff_login_directory")
}

model Owner {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, email])
  @@map("owners")
}

/// Global platform operator (you). Login at POST /platform/v1/auth/login — separate from restaurant staff.
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("platform_admins")
}
