{
  "name": "maklago-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate --schema prisma/registry/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/registry/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma",
    "prisma:migrate:registry": "prisma migrate deploy --schema prisma/registry/schema.prisma",
    "prisma:migrate:tenant": "prisma migrate deploy --schema prisma/tenant/schema.prisma",
    "prisma:migrate:tenant:url": "ts-node src/scripts/migrateTenantDatabase.ts",
    "prisma:studio:registry": "prisma studio --schema prisma/registry/schema.prisma",
    "prisma:studio:tenant": "prisma studio --schema prisma/tenant/schema.prisma --port 5556",
    "seed": "ts-node src/scripts/seedDemo.ts",
    "seed:chef": "ts-node src/scripts/createChefAccount.ts",
    "backfill:staff-directory": "ts-node src/scripts/backfillStaffLoginDirectory.ts",
    "registry:sync-staff-ids": "ts-node src/scripts/syncRegistryStaffIdsAfterTenantMigration.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/index.js",
    "dev": "nodemon",
    "test": "vitest run",
    "test:integration": "cross-env INTEGRATION_TEST=1 vitest run src/app.integration.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "prisma": "5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
