PORT=3000

# Optional: absolute API origin (no trailing slash) for catalog image URLs when the app is behind a reverse proxy
# PUBLIC_BASE_URL=https://api.example.com

# Comma-separated browser origins, or * for permissive CORS (omit to disable CORS middleware)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

REGISTRY_DATABASE_URL=postgresql://maklago:maklago@localhost:5432/maklago_registry
TENANT_DATABASE_URL=postgresql://maklago:maklago@localhost:5432/maklago_tenant_demo

TENANT_SOURCE=header
TENANT_HEADER=x-tenant-id
# BASE_DOMAIN=example.com

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Platform: super admin login POST /platform/v1/auth/login (also seeded by npm run seed)
PLATFORM_ADMIN_EMAIL=admin@maklago.local
PLATFORM_ADMIN_PASSWORD=admin123456

# Optional: automation / scripts — same routes also accept x-platform-key when set
PLATFORM_API_KEY=platform-dev-key
